<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>PetPlanner</AssemblyName>
    <RootNamespace>KaoyanPlanner.WPF</RootNamespace>
    <!-- 应用版本：关于页与 Windows 文件属性展示（AppInfo.Version 与此保持一致） -->
    <Version>2.2.7</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\icon.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- 公共中性版开关：-p:PublicNeutral=true 时定义 PUBLIC_NEUTRAL → Brand.cs 走「小蓝」分支。
         默认不带此参数 = 个人版「艾莲」，此处不触碰 DefineConstants（保持 SDK 默认值）。 -->
    <DefineConstants Condition="'$(PublicNeutral)' == 'true'">$(DefineConstants);PUBLIC_NEUTRAL</DefineConstants>
    <!-- 安装包测试版开关：-p:TestBuild=true 时定义 TEST_BUILD → AppInfo.cs 走「测试版」身份
         （单实例管道/自启项/关于页/托盘区分），与个人版互不干扰；打包脚本会带上它。 -->
    <DefineConstants Condition="'$(TestBuild)' == 'true'">$(DefineConstants);TEST_BUILD</DefineConstants>
  </PropertyGroup>

  <!-- 开发运行：把仓库根的 data.json 拷到输出目录一份（改的只是副本，真文件不动） -->
  <!-- ExcludeFromSingleFile：单文件发布时仍以实体文件放在 exe 旁，代码用相对路径读 -->
  <ItemGroup>
    <None Include="..\..\data.json" Link="data.json" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!-- 桌宠动画资源：desk_pet 顶层 .ani + 每个形象子文件夹（皮肤）随构建分发。
       递归 glob 保留子目录结构（RecursiveDir）；preview.png 作为设置里的预览图同样分发。
       发布后与 exe 同级，代码按磁盘路径读 → ExcludeFromSingleFile 保持实体文件。 -->
  <ItemGroup>
    <None Include="..\..\desk_pet\**\*.ani" Link="desk_pet\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="..\..\desk_pet\**\*.png" Link="desk_pet\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!-- 应用图标资源：仓库 assets/icon.png 内嵌进程序集（pack://application 可访问，单文件发布不丢） -->
  <ItemGroup>
    <Resource Include="..\..\assets\icon.png" Link="assets\icon.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

</Project>
