<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================
         深色主题（休眠备用，阶段二启用暗色模式时合并此字典）
         值取自 theme.py _DARK_QSS / _WORKSPACE_DARK / §6.1
         ================================================================ -->

    <Color x:Key="CanvasColor">#171717</Color>
    <Color x:Key="RailColor">#1C1C1C</Color>
    <Color x:Key="SurfaceColor">#212121</Color>
    <Color x:Key="ElevatedColor">#2A2A2A</Color>
    <Color x:Key="BorderColor">#353535</Color>
    <Color x:Key="BorderStrongColor">#3A3A3A</Color>
    <Color x:Key="InputColor">#2A2A2A</Color>
    <Color x:Key="PressedColor">#262626</Color>
    <Color x:Key="HoverFillColor">#2A2A2A</Color>
    <Color x:Key="TrackColor">#383838</Color>
    <Color x:Key="ScrollHandleColor">#4A4A4A</Color>
    <Color x:Key="ScrollHandleHoverColor">#5A5A5A</Color>
    <Color x:Key="CheckBorderColor">#5A5A5A</Color>

    <Color x:Key="TextPrimaryColor">#ECECEC</Color>
    <Color x:Key="TextSecondaryColor">#B5B5B5</Color>
    <Color x:Key="TextMutedColor">#7C7C7C</Color>
    <Color x:Key="TextDoneColor">#6A6A6A</Color>
    <Color x:Key="EmptyStateColor">#5C5C5C</Color>

    <Color x:Key="AccentColor">#339CFF</Color>
    <Color x:Key="AccentHoverColor">#4DA6FF</Color>
    <Color x:Key="AccentStrongColor">#66B7FF</Color>
    <Color x:Key="AccentSoftColor">#66B7FF</Color>

    <Color x:Key="SuccessColor">#39B77A</Color>
    <Color x:Key="WarnColor">#E6A23C</Color>
    <Color x:Key="DangerColor">#E05252</Color>
    <Color x:Key="DangerHoverColor">#F06868</Color>
    <Color x:Key="DangerSoftFillColor">#3A2424</Color>

    <Color x:Key="AccentSoftFillColor">#29339CFF</Color>      <!-- 0.16 -->
    <Color x:Key="AccentSoftFillHoverColor">#33339CFF</Color>
    <Color x:Key="AccentBorderSoftColor">#66339CFF</Color>    <!-- 0.40 -->
    <Color x:Key="AccentBorderStrongColor">#80339CFF</Color>
    <Color x:Key="RailSelectedFillColor">#29339CFF</Color>

    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />
    <SolidColorBrush x:Key="RailBrush" Color="{StaticResource RailColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="ElevatedBrush" Color="{StaticResource ElevatedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="InputBrush" Color="{StaticResource InputColor}" />
    <SolidColorBrush x:Key="PressedBrush" Color="{StaticResource PressedColor}" />
    <SolidColorBrush x:Key="HoverFillBrush" Color="{StaticResource HoverFillColor}" />
    <SolidColorBrush x:Key="TrackBrush" Color="{StaticResource TrackColor}" />
    <SolidColorBrush x:Key="ScrollHandleBrush" Color="{StaticResource ScrollHandleColor}" />
    <SolidColorBrush x:Key="ScrollHandleHoverBrush" Color="{StaticResource ScrollHandleHoverColor}" />
    <SolidColorBrush x:Key="CheckBorderBrush" Color="{StaticResource CheckBorderColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextDoneBrush" Color="{StaticResource TextDoneColor}" />
    <SolidColorBrush x:Key="EmptyStateBrush" Color="{StaticResource EmptyStateColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentStrongBrush" Color="{StaticResource AccentStrongColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="{StaticResource DangerHoverColor}" />
    <SolidColorBrush x:Key="DangerSoftFillBrush" Color="{StaticResource DangerSoftFillColor}" />

    <SolidColorBrush x:Key="AccentSoftFillBrush" Color="{StaticResource AccentSoftFillColor}" />
    <SolidColorBrush x:Key="AccentSoftFillHoverBrush" Color="{StaticResource AccentSoftFillHoverColor}" />
    <SolidColorBrush x:Key="AccentBorderSoftBrush" Color="{StaticResource AccentBorderSoftColor}" />
    <SolidColorBrush x:Key="AccentBorderStrongBrush" Color="{StaticResource AccentBorderStrongColor}" />
    <SolidColorBrush x:Key="RailSelectedFillBrush" Color="{StaticResource RailSelectedFillColor}" />

    <SolidColorBrush x:Key="FocusRingBrush" Color="{StaticResource AccentColor}" />

    <!-- 图表色板（深色变体略亮，保证暗底可读；键集必须与 Colors.xaml 对称） -->
    <Color x:Key="Chart1Color">#4DA6FF</Color>
    <Color x:Key="Chart2Color">#4CC98A</Color>
    <Color x:Key="Chart3Color">#F0B554</Color>
    <Color x:Key="Chart4Color">#F06868</Color>
    <Color x:Key="Chart5Color">#B58AE8</Color>
    <Color x:Key="Chart6Color">#F294C0</Color>
    <SolidColorBrush x:Key="Chart1Brush" Color="{StaticResource Chart1Color}" />
    <SolidColorBrush x:Key="Chart2Brush" Color="{StaticResource Chart2Color}" />
    <SolidColorBrush x:Key="Chart3Brush" Color="{StaticResource Chart3Color}" />
    <SolidColorBrush x:Key="Chart4Brush" Color="{StaticResource Chart4Color}" />
    <SolidColorBrush x:Key="Chart5Brush" Color="{StaticResource Chart5Color}" />
    <SolidColorBrush x:Key="Chart6Brush" Color="{StaticResource Chart6Color}" />

</ResourceDictionary>
