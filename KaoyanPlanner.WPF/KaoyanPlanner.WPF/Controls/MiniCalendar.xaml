<UserControl x:Class="KaoyanPlanner.WPF.Controls.MiniCalendar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="340" d:DesignHeight="360"
             Foreground="{StaticResource TextPrimaryBrush}">

    <Border x:Name="root" Background="{StaticResource ElevatedBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12"
            Padding="10,8,10,10" SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 头部：‹ 年月标题 › -->
            <Grid Grid.Row="0" Margin="2,0,2,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="prevBtn" Grid.Column="0" Style="{StaticResource GhostIconButtonStyle}"
                        Width="30" Height="30" Padding="0" ToolTip="上个月" Click="Prev_Click">
                    <TextBlock Text="&#xE76B;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                </Button>

                <Button x:Name="titleBtn" Grid.Column="1" Height="30" Padding="0" Margin="4,0"
                        Style="{StaticResource GhostIconButtonStyle}" ToolTip="选择年月" Click="Title_Click">
                    <TextBlock x:Name="titleText" Style="{StaticResource TitleText}" FontSize="14"
                               VerticalAlignment="Center" />
                </Button>

                <Button x:Name="nextBtn" Grid.Column="2" Style="{StaticResource GhostIconButtonStyle}"
                        Width="30" Height="30" Padding="0" ToolTip="下个月" Click="Next_Click">
                    <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                </Button>
            </Grid>

            <!-- 星期行 -->
            <UniformGrid x:Name="weekRow" Grid.Row="1" Columns="7" Margin="2,0,2,2" />

            <!-- 日期格（代码填充） -->
            <Grid x:Name="dayHost" Grid.Row="2" Margin="0,2,0,0" />

            <!-- 年月选择器弹层 -->
            <Popup x:Name="ymPopup" PlacementTarget="{Binding ElementName=titleBtn}" Placement="Bottom"
                   AllowsTransparency="True" StaysOpen="False" IsHitTestVisible="True">
                <Border Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10" Margin="0,6,0,0"
                        Effect="{StaticResource PopupShadowEffect}" Padding="10">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ymPrevYear" Style="{StaticResource GhostIconButtonStyle}"
                                    Width="28" Height="28" Padding="0" Click="YmPrevYear_Click">
                                <TextBlock Text="&#xE76B;" FontFamily="{StaticResource IconFont}" FontSize="11" />
                            </Button>
                            <TextBlock x:Name="ymYearText" Grid.Column="1" Style="{StaticResource TitleText}"
                                       FontSize="14" TextAlignment="Center" VerticalAlignment="Center" />
                            <Button x:Name="ymNextYear" Grid.Column="2" Style="{StaticResource GhostIconButtonStyle}"
                                    Width="28" Height="28" Padding="0" Click="YmNextYear_Click">
                                <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="11" />
                            </Button>
                        </Grid>
                        <UniformGrid x:Name="ymMonths" Columns="3" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>
</UserControl>
