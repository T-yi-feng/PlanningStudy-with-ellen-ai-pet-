<Window x:Class="KaoyanPlanner.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PetPlanner"
        Width="1280" Height="800" MinWidth="1024" MinHeight="680"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource CanvasBrush}"
        Icon="pack://application:,,,/assets/icon.png"
        WindowStartupLocation="CenterScreen"
        StateChanged="Window_StateChanged">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" GlassFrameThickness="0"
                            ResizeBorderThickness="6" CornerRadius="12"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 自定义窗口按钮：最小化/最大化/关闭 -->
        <Style x:Key="WindowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverFillBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RailIconButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostIconButtonStyle}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="40" />
            <Setter Property="FontSize" Value="18" />
        </Style>
        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource DangerBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="rootBorder">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <!-- ===================== 顶部标题栏（拖拽区） ===================== -->
            <Grid Grid.Row="0" Background="{StaticResource SurfaceBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,12,0" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/assets/icon.png" Width="22" Height="22"
                           Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock x:Name="titleText" Style="{StaticResource TitleText}" Cursor="IBeam"
                               shell:WindowChrome.IsHitTestVisibleInChrome="True"
                               ToolTip="双击修改标题" MouseLeftButtonDown="TitleText_MouseLeftButtonDown" />
                    <TextBox x:Name="titleEdit" Visibility="Collapsed" MinWidth="140" MaxWidth="340"
                             shell:WindowChrome.IsHitTestVisibleInChrome="True"
                             FontFamily="{StaticResource UIFont}" FontSize="16" FontWeight="Bold"
                             Padding="4,1" KeyDown="TitleEdit_KeyDown" LostKeyboardFocus="TitleEdit_LostFocus" />
                </StackPanel>
                <Border x:Name="countdownPill" Grid.Column="1" VerticalAlignment="Center"
                        Style="{StaticResource PillAccentStyle}">
                    <TextBlock x:Name="countdownText" Style="{StaticResource MetadataText}"
                               Foreground="{StaticResource AccentStrongBrush}" />
                </Border>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button x:Name="minimizeBtn" Style="{StaticResource WindowButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="最小化" Click="Minimize_Click">🗕</Button>
                    <Button x:Name="maximizeBtn" Style="{StaticResource WindowButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="最大化" Click="Maximize_Click">🗖</Button>
                    <Button x:Name="closeBtn" Style="{StaticResource CloseButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="关闭到托盘" Click="Close_Click">✕</Button>
                </StackPanel>
            </Grid>

            <!-- ===================== 主体三列：rail | sidebar | main ===================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="sidebarCol" Width="272" MinWidth="228" MaxWidth="380" />
                    <ColumnDefinition Width="*" MinWidth="560" />
                </Grid.ColumnDefinitions>

                <!-- 导航栏 -->
                <Border Grid.Column="0" Background="{StaticResource RailBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,8,0,0">
                            <Border HorizontalAlignment="Center" Margin="0,0,0,10"
                                    Width="32" Height="32" CornerRadius="8"
                                    Background="{StaticResource AccentBrush}">
                                <TextBlock Text="✓" FontSize="16" FontWeight="Bold"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <RadioButton x:Name="railPlan" Style="{StaticResource RailButtonStyle}" GroupName="rail"
                                         IsChecked="True" ToolTip="今日计划" Tag="plan">📋</RadioButton>
                            <RadioButton x:Name="railTimer" Style="{StaticResource RailButtonStyle}" GroupName="rail"
                                         ToolTip="专注计时" Tag="timer">⏱</RadioButton>
                            <RadioButton x:Name="railReminder" Style="{StaticResource RailButtonStyle}" GroupName="rail"
                                         ToolTip="提醒" Tag="reminder">🔔</RadioButton>
                            <RadioButton x:Name="railStats" Style="{StaticResource RailButtonStyle}" GroupName="rail"
                                         ToolTip="专注统计" Tag="stats">📊</RadioButton>
                        </StackPanel>
                        <RadioButton x:Name="railSettings" Grid.Row="2" Style="{StaticResource RailButtonStyle}"
                                     GroupName="rail" Tag="settings" ToolTip="设置"
                                     Click="Settings_Click">⚙</RadioButton>
                    </Grid>
                </Border>

                <!-- 侧边栏分割线 -->
                <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Center"
                              Background="{StaticResource BorderBrush}"
                              ResizeBehavior="PreviousAndNext" ShowsPreview="False" />

                <!-- 今日任务侧边栏（M6：紧凑只读列表，完整编辑在 PlanTab） -->
                <Border x:Name="sidebarHost" Grid.Column="2" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" />

                <!-- 主区（M3 起放 4 个面板） -->
                <Border Grid.Column="3" Background="{StaticResource CanvasBrush}">
                    <ContentControl x:Name="mainHost">
                        <TextBlock Text="工作台就绪" Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </ContentControl>
                </Border>
            </Grid>

            <!-- ===================== 状态栏 ===================== -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <TextBlock x:Name="statusText" Style="{StaticResource MutedText}" Margin="14,0" VerticalAlignment="Center" />
            </Border>
        </Grid>
    </Border>
</Window>
