<UserControl x:Class="KaoyanPlanner.WPF.Views.Tabs.ReminderTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:KaoyanPlanner.WPF.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="860"
             Foreground="{StaticResource TextPrimaryBrush}">

    <Grid Margin="18,14,18,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 工具栏：添加提醒 / 下次提醒摘要 / 今天 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="addBtn" Style="{StaticResource PrimaryButtonStyle}" MinWidth="108"
                    Click="Add_Click" Cursor="Hand">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="添加提醒" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <TextBlock x:Name="nextLbl" Grid.Column="1" Style="{StaticResource MutedText}" FontSize="12"
                       Margin="14,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button x:Name="todayBtn" Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}"
                    MinWidth="72" Click="Today_Click" Content="今天" Cursor="Hand" />
        </Grid>

        <!-- 单行日期条：收窄（不占满全宽），今天居左 1/4，两侧前后几天；点哪天 → 下方两天表格左右丝滑切换 -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="4,4" Margin="0,10,0,6"
                HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="stripPrev" Style="{StaticResource GhostIconButtonStyle}" Width="28" Height="28"
                        Padding="0" VerticalAlignment="Center" Click="StripPrev_Click" ToolTip="往前翻一周">
                    <TextBlock Text="&#xE76B;" FontFamily="{StaticResource IconFont}" FontSize="11" />
                </Button>
                <StackPanel x:Name="stripGrid" Orientation="Horizontal" Margin="2,0" />
                <Button x:Name="stripNext" Style="{StaticResource GhostIconButtonStyle}" Width="28" Height="28"
                        Padding="0" VerticalAlignment="Center" Click="StripNext_Click" ToolTip="往后翻一周">
                    <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="11" />
                </Button>
            </StackPanel>
        </Border>

        <!-- 两天时间表：选中日 + 次日 并排；点击不同天 → 整块左右丝滑滑动 + 末端高斯模糊渐隐 -->
        <Border x:Name="tableCard" Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0" Margin="0,6,0,0"
                ClipToBounds="True" MouseWheel="TableCard_MouseWheel">
            <Grid x:Name="slideRoot" ClipToBounds="True">
                <!-- groupA / groupB（双组轮播）与左右渐隐遮罩由代码创建 -->
            </Grid>
        </Border>

        <!-- 未完成任务提醒：每 N 分钟检查当天待办 -->
        <Border Grid.Row="3" Style="{StaticResource SectionHeaderStyle}" Margin="0,12,0,0"
                Padding="12,6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="unfinishedCheck" Content="未完成任务提醒"
                          ToolTip="当天有待办未完成时，每隔设定时间在右下角弹窗" />
                <TextBlock Text="每" Style="{StaticResource MutedText}" Margin="12,0,4,0" VerticalAlignment="Center" />
                <controls:NumberStepper x:Name="intervalStepper" Min="10" Max="180" Step="5"
                                        ValueChanged="IntervalStepper_Changed" />
                <TextBlock Text="分钟弹窗提醒待办" Style="{StaticResource MutedText}" Margin="6,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
