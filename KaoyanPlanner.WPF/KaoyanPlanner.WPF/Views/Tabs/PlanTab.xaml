<UserControl x:Class="KaoyanPlanner.WPF.Views.Tabs.PlanTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="860">
    <UserControl.Resources>
        <!-- 冻结 ToggleButton：外观对齐 SecondaryButton，选中 = accent 软填充 -->
        <Style x:Key="SecondaryToggleStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource ElevatedBrush}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentStrongBrush}" />
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoftFillBrush}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBorderSoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 冻结 / 欠卡横幅 -->
        <Border x:Name="bannerBar" Grid.Row="0" Visibility="Collapsed"
                Background="{StaticResource WarnSoftFillBrush}"
                BorderBrush="{StaticResource WarnBorderSoftBrush}"
                BorderThickness="1" CornerRadius="8" Margin="0,0,0,10" Padding="10,7">
            <TextBlock x:Name="bannerText" TextWrapping="Wrap"
                       FontFamily="{StaticResource UIFont}" FontSize="12" LineHeight="18"
                       Foreground="{StaticResource WarnBrush}" />
        </Border>

        <!-- 任务列表 -->
        <ScrollViewer x:Name="listScroll" Grid.Row="1"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Margin="0,0,6,0">
            <StackPanel x:Name="taskStack" />
        </ScrollViewer>

        <!-- 空态 -->
        <Border x:Name="emptyCard" Grid.Row="1" Style="{StaticResource EmptyStateCardStyle}"
                Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="📋" FontSize="30" HorizontalAlignment="Center" />
                <TextBlock Text="今天还没有计划" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,10,0,2" />
                <TextBlock Text="先写下一个最小可完成任务" Style="{StaticResource MutedText}" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- 进度 -->
        <Grid Grid.Row="2" Margin="0,6,0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="progressText" Style="{StaticResource MetadataText}" Margin="0,0,12,0" VerticalAlignment="Center" />
            <ProgressBar x:Name="progressBar" Grid.Column="1" Style="{StaticResource MiniProgressBarStyle}"
                         Height="6" VerticalAlignment="Center" />
        </Grid>

        <!-- 控制行 -->
        <Grid Grid.Row="3" Margin="0,2,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ToggleButton x:Name="freezeBtn" Style="{StaticResource SecondaryToggleStyle}" Content="❄ 冻结任务" />
            <Button Grid.Column="2" x:Name="clearDoneBtn" Style="{StaticResource SecondaryButtonStyle}" Content="清理已完成" />
        </Grid>

        <!-- 输入行 -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox x:Name="inputBox" KeyDown="InputBox_KeyDown" />
                <TextBlock x:Name="inputHint" Text="输入任务，回车添加" Style="{StaticResource MutedText}"
                           Margin="10,0,0,0" IsHitTestVisible="False" VerticalAlignment="Center" />
            </Grid>
            <Button Grid.Column="1" x:Name="addBtn" Style="{StaticResource PrimaryButtonStyle}" Content="添加" Margin="8,0,0,0" />
            <Button Grid.Column="2" x:Name="addFixedBtn" Style="{StaticResource SecondaryButtonStyle}" Content="＋ 固定" Margin="8,0,0,0" />
        </Grid>
    </Grid>
</UserControl>
