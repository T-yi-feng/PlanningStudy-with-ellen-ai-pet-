<Window x:Class="KaoyanPlanner.WPF.Views.Dialogs.PlanNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="计划" Width="340" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}"
        KeyDown="Window_KeyDown" Foreground="{StaticResource TextPrimaryBrush}">
    <Border x:Name="rootCard" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12"
            Background="{StaticResource SurfaceBrush}">
        <StackPanel Margin="18,16,18,18">
            <TextBlock x:Name="dlgTitle" Text="新建计划" Style="{StaticResource TitleText}" />

            <TextBlock Text="计划名称" Style="{StaticResource MetadataText}" Margin="0,14,0,4" />
            <TextBox x:Name="nameBox" MaxLength="30" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="取消" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" IsCancel="True" />
                <Button Content="确定" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" Click="OkBtn_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
