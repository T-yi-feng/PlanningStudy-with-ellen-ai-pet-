<Window x:Class="KaoyanPlanner.WPF.Views.Dialogs.FixedTaskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="固定任务" Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}"
        KeyDown="Window_KeyDown">
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10"
            Background="{StaticResource SurfaceBrush}">
        <StackPanel Margin="18,16,18,18">
            <TextBlock x:Name="dlgTitle" Text="添加固定任务" Style="{StaticResource TitleText}" />

            <TextBlock Text="内容" Style="{StaticResource MetadataText}" Margin="0,14,0,4" />
            <TextBox x:Name="textBox" />

            <TextBlock Text="简介（可选）" Style="{StaticResource MetadataText}" Margin="0,12,0,4" />
            <TextBox x:Name="descBox" />

            <TextBlock Text="需几天完成" Style="{StaticResource MetadataText}" Margin="0,12,0,4" />
            <TextBox x:Name="daysBox" Text="1" MaxLength="4" HorizontalAlignment="Left" Width="120"
                     PreviewTextInput="DaysBox_PreviewTextInput" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="取消" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" IsCancel="True" />
                <Button Content="确定" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" Click="OkBtn_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
