<UserControl x:Class="KaoyanPlanner.WPF.Views.Settings.SettingsCaptionTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{StaticResource TextPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,24" MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource TitleText}" Text="实时媒体字幕" />
            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,16"
                       Text="识别电脑播放的声音，显示在黑板窗。改动立即生效，文本框回车/失焦提交。" TextWrapping="Wrap" />

            <TextBlock Text="识别 Key（写入本地 secret.json，不入库）" Style="{StaticResource MetadataText}" Margin="0,0,0,4" />
            <PasswordBox x:Name="keyBox" PasswordChar="●"
                         ToolTip="申请硅基流动 Key：cloud.siliconflow.cn" />

            <TextBlock Text="识别模型" Style="{StaticResource MetadataText}" Margin="0,12,0,4" />
            <ComboBox x:Name="modelBox">
                <ComboBoxItem Tag="FunAudioLLM/SenseVoiceSmall">SenseVoiceSmall · 实时低延迟（推荐）</ComboBoxItem>
                <ComboBoxItem Tag="TeleAI/TeleSpeechASR">TeleSpeechASR · 高精度 / 方言强</ComboBoxItem>
            </ComboBox>

            <TextBlock Text="字幕语言" Style="{StaticResource MetadataText}" Margin="0,12,0,4" />
            <ComboBox x:Name="langBox">
                <ComboBoxItem Tag="auto">自动识别</ComboBoxItem>
                <ComboBoxItem Tag="zh">中文</ComboBoxItem>
                <ComboBoxItem Tag="en">英文</ComboBoxItem>
                <ComboBoxItem Tag="yue">粤语</ComboBoxItem>
                <ComboBoxItem Tag="ja">日语</ComboBoxItem>
                <ComboBoxItem Tag="ko">韩语</ComboBoxItem>
            </ComboBox>

            <TextBlock Text="字号（12–40）" Style="{StaticResource MetadataText}" Margin="0,12,0,4" />
            <TextBox x:Name="sizeBox" Width="80" HorizontalAlignment="Left" />

            <TextBlock Text="颜色" Style="{StaticResource MetadataText}" Margin="0,12,0,4" />
            <StackPanel Orientation="Horizontal">
                <StackPanel x:Name="colorPanel" Orientation="Horizontal" />
                <Button x:Name="customBtn" Content="自定义…" Style="{StaticResource SecondaryButtonStyle}"
                        Margin="6,0,0,0" Click="Custom_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
