<UserControl x:Class="KaoyanPlanner.WPF.Views.Settings.SettingsGeneralTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" Foreground="{StaticResource TextPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,24" MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource TitleText}" Text="通用设置" />
            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,16"
                       Text="以下修改立即生效。" TextWrapping="Wrap" />

            <TextBlock Text="考研日期" Style="{StaticResource MetadataText}" Margin="0,0,0,4" />
            <DatePicker x:Name="examPicker" Language="zh-CN" SelectedDateFormat="Short"
                        Height="32" FontFamily="{DynamicResource UIFont}" Width="220" HorizontalAlignment="Left" />

            <CheckBox x:Name="topmostCheck" Content="窗口置顶" Margin="0,16,0,0"
                      ToolTip="主窗口保持在最上层，贴合旧版浮窗习惯" />
            <CheckBox x:Name="autostartCheck" Content="开机自启" Margin="0,12,0,0"
                      ToolTip="登录 Windows 时自动启动（写入注册表，不碰数据文件）" />
            <CheckBox x:Name="reduceMotionCheck" Content="降低动效" Margin="0,12,0,0"
                      ToolTip="关闭面板切换动画，减少晃动" />

            <TextBlock Style="{StaticResource TitleText}" Text="字体" Margin="0,22,0,4" />
            <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,12" TextWrapping="Wrap"
                       Text="选择界面字体与粗细，全站文字立即生效（图标字形除外）。标注「圆润」的字体字形更柔和，适合长时间阅读。" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="字体" Style="{StaticResource MetadataText}"
                           VerticalAlignment="Center" Margin="0,0,0,10" />
                <ComboBox x:Name="fontBox" Grid.Row="0" Grid.Column="1" Height="32"
                          Width="300" HorizontalAlignment="Left" VerticalContentAlignment="Center"
                          SelectionChanged="Font_Changed" ToolTip="界面字体（下拉项按各自字体预览）">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}" FontFamily="{Binding Family}" FontSize="14"
                                       Padding="2,3" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="字重" Style="{StaticResource MetadataText}"
                           VerticalAlignment="Center" Margin="0,10,0,0" />
                <ComboBox x:Name="weightBox" Grid.Row="1" Grid.Column="1" Height="32"
                          Width="300" HorizontalAlignment="Left" VerticalContentAlignment="Center"
                          Margin="0,10,0,0" SelectionChanged="Weight_Changed"
                          ToolTip="全站文字粗细（蓝底文字恒为白色，不受影响）" />
            </Grid>

            <Border Style="{StaticResource CardStyle}" Margin="0,20,0,0" Padding="14,12">
                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                           Text="修改考研日期会立刻刷新标题栏的「距考研还有 N 天」倒计时；字体与字重改动立即在全应用生效。" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
