<UserControl x:Class="KaoyanPlanner.WPF.Views.Settings.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <!-- 分栏导航项：左侧文字行，选中 = 浅蓝底 + 强调色文字（不是大块蓝底） -->
        <Style x:Key="SettingsNavItemStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0,2,0,2" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverFillBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoftFillBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentStrongBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头：← 返回 + 标题（设置立即生效，无保存按钮） -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,14,20,10">
            <Button x:Name="backBtn" Content="← 返回" Style="{StaticResource SecondaryButtonStyle}"
                    Click="Back_Click" />
            <TextBlock x:Name="pageTitle" Style="{StaticResource PageTitleText}" Margin="16,0,0,0"
                       VerticalAlignment="Center" />
        </StackPanel>

        <!-- 左侧分栏 + 右侧内容 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" MinWidth="160" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,0">
                <StackPanel Margin="12,4,12,12">
                    <RadioButton x:Name="navGeneral" Style="{StaticResource SettingsNavItemStyle}" GroupName="sect"
                                 Tag="general" Content="⚙ 通用" Click="Nav_Click" />
                    <RadioButton x:Name="navPet" Style="{StaticResource SettingsNavItemStyle}" GroupName="sect"
                                 Tag="pet" Content="🐾 桌宠" Click="Nav_Click" />
                    <RadioButton x:Name="navChat" Style="{StaticResource SettingsNavItemStyle}" GroupName="sect"
                                 Tag="chat" Content="💬 AI 聊天" Click="Nav_Click" />
                    <RadioButton x:Name="navTts" Style="{StaticResource SettingsNavItemStyle}" GroupName="sect"
                                 Tag="tts" Content="🔊 语音播报" Click="Nav_Click" />
                    <RadioButton x:Name="navCaption" Style="{StaticResource SettingsNavItemStyle}" GroupName="sect"
                                 Tag="caption" Content="🎙 实时字幕" Click="Nav_Click" />
                    <RadioButton x:Name="navAbout" Style="{StaticResource SettingsNavItemStyle}" GroupName="sect"
                                 Tag="about" Content="ℹ 关于" Click="Nav_Click" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource BorderBrush}" />

            <Border Grid.Column="2" Background="{StaticResource CanvasBrush}">
                <ContentControl x:Name="sectionHost" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
