<UserControl x:Class="KaoyanPlanner.WPF.Views.Settings.SettingsPetTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,24" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource TitleText}" Text="桌宠形象" />
            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,12"
                       Text="每个外观是 exe 旁 desk_pet 下的一个文件夹：normal/talking/happy/present.ani（可选 sleep.ani、preview.png）。也兼容旧版默认命名。" TextWrapping="Wrap" />

            <!-- 皮肤卡片列表（代码构建） -->
            <WrapPanel x:Name="skinList" />

            <!-- 导入 / 打开文件夹 -->
            <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                <Button x:Name="browseBtn" Content="导入皮肤文件夹…" Style="{StaticResource SecondaryButtonStyle}"
                        Click="Browse_Click" />
                <Button x:Name="openFolderBtn" Content="打开皮肤文件夹" Style="{StaticResource SecondaryButtonStyle}"
                        Margin="8,0,0,0" Click="OpenFolder_Click" />
            </StackPanel>

            <!-- 拖拽投放区 -->
            <Border x:Name="dropZone" Background="{StaticResource InputBrush}"
                    BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="20" MinHeight="96"
                    AllowDrop="True" DragOver="DropZone_DragOver" Drop="DropZone_Drop">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📁" FontSize="26" HorizontalAlignment="Center" />
                    <TextBlock Text="把皮肤文件夹拖到这里即可导入" Style="{StaticResource MutedText}"
                               HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="importMsg" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                       Foreground="{StaticResource DangerBrush}" Margin="0,8,0,0" Visibility="Collapsed" />

            <!-- 闲话配置 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,20,0,0" Padding="14,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="idleCheck" Content="开启桌宠闲话" VerticalAlignment="Center" />
                    <TextBlock Text="每" Style="{StaticResource MutedText}" Margin="12,0,4,0" VerticalAlignment="Center" />
                    <TextBox x:Name="idleInterval" Width="52" VerticalContentAlignment="Center"
                             ToolTip="2–999 分钟" />
                    <TextBlock Text="分钟聊一次" Style="{StaticResource MutedText}" Margin="4,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
