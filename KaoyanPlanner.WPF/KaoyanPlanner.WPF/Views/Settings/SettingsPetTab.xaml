<UserControl x:Class="KaoyanPlanner.WPF.Views.Settings.SettingsPetTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:KaoyanPlanner.WPF.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,24" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource TitleText}" Text="桌宠形象" />
            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,12"
                       Text="桌宠外观即「皮肤」。每个皮肤是一个文件夹，放在程序旁的 desk_pet 目录下，内含 normal / talking / happy / present 四组动画帧（可选 sleep 入睡动画与 preview 预览图），也兼容旧版默认命名。" TextWrapping="Wrap" />

            <!-- 皮肤卡片列表（代码构建） -->
            <WrapPanel x:Name="skinList" />

            <!-- 导入 / 打开文件夹 -->
            <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                <Button x:Name="browseBtn" Content="导入皮肤文件夹…" Style="{StaticResource SecondaryButtonStyle}"
                        Click="Browse_Click" />
                <Button x:Name="openFolderBtn" Content="打开皮肤文件夹" Style="{StaticResource SecondaryButtonStyle}"
                        Margin="8,0,0,0" Click="OpenFolder_Click" />
            </StackPanel>

            <!-- 拖拽投放区 -->
            <Border x:Name="dropZone" Background="{StaticResource InputBrush}"
                    BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="20" MinHeight="96"
                    AllowDrop="True" DragOver="DropZone_DragOver" Drop="DropZone_Drop">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="24"
                               HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="把皮肤文件夹拖到这里即可导入" Style="{StaticResource MutedText}"
                               HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="importMsg" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                       Foreground="{StaticResource DangerBrush}" Margin="0,8,0,0" Visibility="Collapsed" />

            <!-- 闲话配置 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,20,0,0" Padding="14,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="idleCheck" Content="开启桌宠闲话" VerticalAlignment="Center" />
                    <TextBlock Text="每" Style="{StaticResource MutedText}" Margin="12,0,4,0" VerticalAlignment="Center" />
                    <controls:NumberStepper x:Name="idleInterval" Min="2" Max="999" Step="1"
                                            ValueChanged="IdleInterval_Changed" />
                    <TextBlock Text="分钟聊一次" Style="{StaticResource MutedText}" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- 桌宠个性化 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="14,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="桌宠个性化" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource MutedText}" Text="大小" VerticalAlignment="Center" />
                        <Slider x:Name="scaleSlider" Grid.Column="1" Minimum="50" Maximum="150" TickFrequency="10"
                                IsSnapToTickEnabled="False" VerticalAlignment="Center" ValueChanged="Scale_Changed" />
                        <TextBlock x:Name="scaleLbl" Grid.Column="2" Style="{StaticResource MetadataText}"
                                   TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource MutedText}" Text="不透明度" VerticalAlignment="Center" />
                        <Slider x:Name="opacitySlider" Grid.Column="1" Minimum="40" Maximum="100" TickFrequency="5"
                                IsSnapToTickEnabled="False" VerticalAlignment="Center" ValueChanged="Opacity_Changed" />
                        <TextBlock x:Name="opacityLbl" Grid.Column="2" Style="{StaticResource MetadataText}"
                                   TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button x:Name="resetPosBtn" Content="重置桌宠位置" Style="{StaticResource SecondaryButtonStyle}"
                                Click="ResetPos_Click" ToolTip="把桌宠移回屏幕右下角默认位置" />
                        <Button x:Name="hidePetBtn" Content="隐藏桌宠" Style="{StaticResource SecondaryButtonStyle}"
                                Margin="8,0,0,0" Click="HidePet_Click" ToolTip="桌宠收进托盘，可从托盘图标重新唤出" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
