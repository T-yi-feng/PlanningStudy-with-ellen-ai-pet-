<UserControl x:Class="KaoyanPlanner.WPF.Views.Settings.SettingsChatTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,24" MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource TitleText}" Text="AI 聊天" />
            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,16"
                       Text="艾莲的闲聊大脑（智谱大模型）。改动立即生效，文本框回车/失焦提交。" TextWrapping="Wrap" />

            <CheckBox x:Name="enabledCheck" Content="启用 AI 聊天" Margin="0,0,0,4" />

            <TextBlock Text="接口地址 base_url" Style="{StaticResource MetadataText}" Margin="0,12,0,4" />
            <TextBox x:Name="urlBox" ToolTip="OpenAI 兼容的 /chat/completions 地址" />

            <TextBlock Text="模型 model" Style="{StaticResource MetadataText}" Margin="0,12,0,4" />
            <TextBox x:Name="modelBox" ToolTip="如 glm-4.7 / glm-4-flash（视觉用 glm-4v-flash）" />

            <TextBlock Text="API Key" Style="{StaticResource MetadataText}" Margin="0,12,0,4" />
            <TextBox x:Name="keyBox" ToolTip="存于 data.json 的 pet_chat 配置" />

            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0" Padding="14,12">
                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                           Text="离线兜底：模型不可用时艾莲会用本地话术回复，不会打断对话。" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
